{
  "name": "multi-ai-prompt-tool",
  "version": "1.0.0",
  "description": "複数の生成AIチャットに同じプロンプトを入力して結果を比較するWebアプリケーション",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "AI",
    "ChatGPT",
    "Claude",
    "Gemini",
    "GitHub Copilot",
    "comparison",
    "prompt"
  ],
  "author": "daydreammodel3",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.9.0",
    "@google/generative-ai": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "typescript": "^5.2.0",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0"
  }
}
